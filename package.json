{
	"name": "naparc",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply naparc --local",
		"db:migrate:production": "wrangler d1 migrations apply naparc --remote",
		"db:transfer:supabase": "node scripts/migrate-supabase-to-d1.js",
		"db:export:supabase": "node scripts/export-supabase-sql.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"seed": "node scripts/seed.js",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"prepare": "husky",
		"test": "vitest"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@sveltejs/adapter-cloudflare": "^7.2.3",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^26.1.1",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"pg": "^8.23.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"wrangler": "^4.68.0"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"cheerio": "^1.2.0",
		"leaflet": "^1.9.4",
		"puppeteer": "^25.3.0",
		"uuid": "^14.0.1"
	}
}
