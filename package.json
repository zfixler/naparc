{
	"name": "naparc",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types --env-file .dev.vars.example",
		"db:migrate:local": "wrangler d1 migrations apply naparc --local",
		"db:migrate:production": "wrangler d1 migrations apply naparc --remote",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"seed": "node scripts/seed.js",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"prepare": "husky",
		"test": "vitest"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.0",
		"@sveltejs/adapter-cloudflare": "^7.2.3",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.2",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"wrangler": "^4.135.0"
	},
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"cheerio": "^1.2.0",
		"leaflet": "^1.9.4",
		"puppeteer": "^25.11.0",
		"uuid": "^14.0.2"
	}
}
